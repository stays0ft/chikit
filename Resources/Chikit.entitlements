<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is NOT sandboxed: its features need system-wide access that macOS
	     gates with permissions at runtime, not with entitlements. The hardened
	     runtime blocks two capabilities it uses, and these entitlements restore
	     them: sending Apple Events (the cleaner, uninstaller and Finder rename drive
	     Finder) and audio input (the optional microphone track in recordings).
	     The user still grants each one through the normal system prompts. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
